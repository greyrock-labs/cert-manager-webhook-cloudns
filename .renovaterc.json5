{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "local>todd/renovate-config"
  ],
  packageRules: [
    {
      // The Kubernetes libraries only compile as a matched set. k8s.io/apiserver
      // is an indirect dependency, and Renovate skips indirect Go dependencies by
      // default, so the stock monorepo group bumps client-go/api/apimachinery and
      // leaves apiserver behind -- which does not build. Enable the indirect ones
      // and group them all so they move together.
      description: "Kubernetes libraries must be updated as a set",
      matchManagers: ["gomod"],
      matchPackageNames: ["k8s.io/**"],
      matchDepTypes: ["require", "indirect"],
      enabled: true,
      groupName: "kubernetes packages"
    },
    {
      // kube-openapi's newer pseudo-versions pull sigs.k8s.io/structured-merge-diff/v7
      // while k8s.io/apimachinery still expects v6, and the mismatch does not compile:
      //   cannot use typeSchema.Types ([]v7/schema.TypeDef) as []v6/schema.TypeDef
      // Held until apimachinery moves to v7. REVIEW THIS when the Kubernetes
      // libraries next take a minor -- it should be removed, not carried forever.
      description: "Hold kube-openapi until apimachinery moves to structured-merge-diff v7",
      matchManagers: ["gomod"],
      matchPackageNames: ["k8s.io/kube-openapi"],
      enabled: false
    }
  ]
}
